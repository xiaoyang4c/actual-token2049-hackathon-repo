{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "installCommand": "bun install && cd web && bun install",
  "buildCommand": "bun run api/_seed.ts && cd web && bun run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/demo.ts": {
      "includeFiles": "{.demo-data/**,packages/db/migrations/**,packages/reliability/src/contract-lifecycle/templates/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {"source": "/reliability/:path*", "destination": "/api/demo?__path=/reliability/:path*"},
    {"source": "/coworkers/ask", "destination": "/api/demo?__path=/coworkers/ask"},
    {"source": "/((?!api/|assets/|brand/).*)", "destination": "/index.html"}
  ]
}
