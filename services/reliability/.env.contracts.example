# Contract lifecycle settings. Copy the values you need into the process environment.
# This file names settings. It contains no keys, no wallet secrets, and no API tokens.
# services/reliability/contract-config.ts is the one loader. Each default below is the loader default.

# --- Network gates (shared with the payment service; see .env.preprod.example) ---
# A contract is live only when both gates are on. Every other combination runs the paper escrow.
CARDANO_MODE=simulated
CARDANO_ALLOW_NETWORK=false
# Live contracts need a V2 payment source and a registered agent (57+ characters).
# MASUMI_PAYMENT_SOURCE_TYPE=Web3CardanoV2
# MASUMI_AGENT_IDENTIFIER=replace-with-registered-agent-identifier
# MASUMI_SUPPORTED_SOURCE_INDEX=0
# The TOKEN2049 guide runs MPS on port 3012.
# MASUMI_PAYMENT_URL=http://127.0.0.1:3012/api/v1

# --- Custody (only one value exists) ---
# Platform-managed preprod test wallets. Written into the signed terms and every outcome.
CONTRACT_CUSTODY_MODEL=platform_custodial_test_only
# custodial_wallet: seller payouts stay on the platform selling wallet (the tested route).
# seller_return_address: signs the seller's own address into the terms (untested with MPS).
CONTRACT_SELLER_PAYOUT=custodial_wallet

# --- Settlement asset: test USDM on preprod (Masumi TOKEN2049 guide). Never ADA. ---
CONTRACT_ASSET_UNIT=16a55b2a349361ff88c03788f93e1e966e5d689605d044fef722ddde0014df10745553444d
CONTRACT_ASSET_DECIMALS=6

# --- Limits ---
# Escrows per milestone. partial_release needs 2 (core and holdback). 1 disables it.
CONTRACT_MAX_TRANCHES_PER_MILESTONE=2
# A dispute must confirm before unlockTime. Disputes close this long before unlockTime.
CONTRACT_DISPUTE_MARGIN_MS=120000
# Evidence files larger than this belong in object storage.
CONTRACT_MAX_EVIDENCE_BYTES=1048576
# Lease on one escrow write. Default: six times CARDANO_REQUEST_TIMEOUT_MS.
# CONTRACT_OPERATION_LEASE_MS=60000
CONTRACT_WORKER_INTERVAL_MS=15000
# Default: hostname and process id.
# CONTRACT_WORKER_ID=

# --- Tier 3 mediator (public key, not a secret) ---
# Without a key, templates that use Tier 3 cannot create contracts.
# CONTRACT_MEDIATOR_ID=platform-mediator
# CONTRACT_MEDIATOR_PUBLIC_KEY_HEX=

# --- Paper escrow ---
CONTRACT_PAPER_CONFIRMATION_MS=3000
# MPS withdraws 10 minutes after unlockTime. A paper demo can shorten this.
CONTRACT_PAPER_AUTO_WITHDRAW_DELAY_MS=600000

# --- Demo windows (override the template windows; written into the signed terms) ---
# Production inspection is 72 h. In live mode MPS still needs 15 minutes between deadlines.
# CONTRACT_DEMO_FUNDING_WINDOW_MS=
# CONTRACT_DEMO_DELIVERY_WINDOW_MS=
# CONTRACT_DEMO_INSPECTION_WINDOW_MS=
# CONTRACT_DEMO_DISPUTE_RESOLUTION_WINDOW_MS=
# CONTRACT_DEMO_DISPUTE_STEP_WINDOW_MS=

# --- Day 2 preprod run (bun run contracts:smoke) ---
# Start early: a clean release takes about 50 minutes.
# CARDANO_MODE=preprod
# CARDANO_ALLOW_NETWORK=true
# MASUMI_PAYMENT_SOURCE_TYPE=Web3CardanoV2
# CONTRACT_DEMO_FUNDING_WINDOW_MS=600000
# CONTRACT_DEMO_DELIVERY_WINDOW_MS=600000
# CONTRACT_DEMO_INSPECTION_WINDOW_MS=900000
# CONTRACT_DEMO_DISPUTE_RESOLUTION_WINDOW_MS=1200000
# CONTRACT_DEMO_DISPUTE_STEP_WINDOW_MS=60000
# CONTRACT_SMOKE_AMOUNT_ATOMIC=1000000
# Optional: the parties' real preprod addresses (identity only in the custodial setup).
# CONTRACT_SMOKE_BUYER_ADDRESS=
# CONTRACT_SMOKE_SELLER_ADDRESS=
