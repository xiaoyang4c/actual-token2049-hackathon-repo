# Copy to seed.env (mode 600) for the one-time seed. Delete it after the seed.
# Generate: openssl rand -hex 24
ADMIN_KEY=<generated admin key>
SEED_ONLY_IF_EMPTY=true
# 24-word phrases generated inside the image (README step 4). The seed prints a phrase only when it generates one, so supply both.
PURCHASE_WALLET_PREPROD_MNEMONIC=<24 words>
SELLING_WALLET_PREPROD_MNEMONIC=<24 words>
