[Unit]
Description=Tally control API and demo services (paper mode)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/tally-app/current
Environment=CONTROL_DB_PATH=/home/ubuntu/tally-app/data/agent.sqlite
# Live deposits from the Tally website: the Blockfrost key file and the deposit address.
# Leave the address empty to turn deposits off. Use the same value as tally-deposits.service.
Environment=TALLY_SECRETS_DIR=/home/ubuntu/tally-secrets
Environment=TALLY_DEPOSIT_ADDRESS=
# on: every sale and contract needs a wallet that the entity proved it controls.
Environment=MARKETPLACE_REQUIRE_WALLET=on
Environment=TALLY_SIGN_IN_DOMAIN=tally-origins.vercel.app
ExecStart=/home/ubuntu/.bun/bin/bun run services/dev.ts
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
