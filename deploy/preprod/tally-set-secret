#!/usr/bin/env bash
# Usage: tally-set-secret NAME
# Reads one secret with hidden input and stores it in ~/tally-secrets/NAME (mode 600).
set -euo pipefail
name="${1:?usage: tally-set-secret NAME}"
case "$name" in *[!a-z0-9_]*) echo "name: lowercase letters, digits, underscores only"; exit 2;; esac
dir=/home/ubuntu/tally-secrets
umask 077
mkdir -p "$dir"
read -rsp "Paste ${name} (input is hidden), then press Enter: " value
echo
value="$(printf %s "$value" | tr -d '[:space:]')"
[ -n "$value" ] || { echo "Empty input. Nothing saved."; exit 1; }
if [ "$name" = blockfrost_preprod ]; then
  case "$value" in preprod*) ;; *) echo "Not a Preprod key (it must start with 'preprod'). Nothing saved."; exit 1;; esac
  code=$(curl -s -o /dev/null -w '%{http_code}' -H @<(printf 'project_id: %s' "$value") https://cardano-preprod.blockfrost.io/api/v0/blocks/latest)
  [ "$code" = 200 ] || { echo "Blockfrost rejected the key (HTTP $code). Nothing saved."; exit 1; }
  echo "Blockfrost accepted the key."
fi
printf %s "$value" > "$dir/$name"
echo "Saved ${name} on the server."
