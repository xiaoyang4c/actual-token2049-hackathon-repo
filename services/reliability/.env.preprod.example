# Preprod escrow example. Copy the values you need into the process environment.
# This file names settings. It does not contain keys or wallet secrets.
# Leave CARDANO_ALLOW_NETWORK=false for a dry run. A dry run does not broadcast.
CARDANO_MODE=preprod
CARDANO_NETWORK=cardano-preprod
CARDANO_ALLOW_NETWORK=false
CARDANO_RECEIPT_DB=services/.data/cardano.sqlite
CARDANO_BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0
CARDANO_BLOCKFROST_KEY_REF=BLOCKFROST_PROJECT_ID_PREPROD
CARDANO_MIN_CONFIRMATIONS=3
CARDANO_REQUEST_TIMEOUT_MS=10000
MASUMI_PAYMENT_URL=http://localhost:3001/api/v1
MASUMI_BUYER_KEY_REF=MASUMI_BUYER_API_KEY
MASUMI_SELLER_KEY_REF=MASUMI_SELLER_API_KEY
# Registered Masumi agent id. Preprod requires at least 57 characters.
MASUMI_AGENT_IDENTIFIER=replace-with-registered-agent-identifier
MASUMI_PAYMENT_SOURCE_TYPE=Web3CardanoV1
MASUMI_SUPPORTED_SOURCE_INDEX=0
# Put the Blockfrost project id in BLOCKFROST_PROJECT_ID_PREPROD.
# Put the Masumi API keys in MASUMI_BUYER_API_KEY and MASUMI_SELLER_API_KEY.
# Set CARDANO_ALLOW_NETWORK=true only when those values are present.
