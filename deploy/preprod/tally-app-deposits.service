[Unit]
Description=Tally app deposit watcher (Cardano preprod)
After=network-online.target tally-app-services.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/tally-app/current
Environment=CONTROL_DB_PATH=/home/ubuntu/tally-app/app-data/agent.sqlite
Environment=TALLY_SECRETS_DIR=/home/ubuntu/tally-app-secrets
EnvironmentFile=/home/ubuntu/tally-app/app.env
ExecStart=/home/ubuntu/.bun/bin/bun run deposits:worker
Restart=always
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
