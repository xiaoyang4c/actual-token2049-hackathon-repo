# Copy to /home/ubuntu/tally-app/app.env. Replace public placeholders on the server.
# Use mode 600. Never commit the filled file or a credential.
TALLY_EDITION=app
CONTROL_DB_PATH=/home/ubuntu/tally-app/app-data/agent.sqlite
CARDANO_RECEIPT_DB=/home/ubuntu/tally-app/app-data/cardano.sqlite
MARKETPLACE_REQUIRE_WALLET=on
TALLY_WEB_ORIGINS=https://<app Amplify domain>
TALLY_SIGN_IN_DOMAIN=<app domain without https://>
CARDANO_MODE=preprod
CARDANO_ALLOW_NETWORK=true
CARDANO_NETWORK=cardano-preprod
TALLY_SECRETS_DIR=/home/ubuntu/tally-app-secrets
TALLY_DEPOSIT_ADDRESS=<dedicated app preprod purchasing wallet address>
TALLY_DEPOSIT_CONFIRMATIONS=3
MASUMI_PAYMENT_URL=http://127.0.0.1:3001/api/v1
MASUMI_AGENT_IDENTIFIER=<app agent identifier>
CONTRACT_MEDIATOR_PUBLIC_KEY_HEX=<mediator raw Ed25519 public key, 64 lowercase hex characters>
CONTRACT_MEDIATOR_ID=app-mediator
# The payment service reads its API key through the credential resolver.
# Set MASUMI_BUYER_API_KEY and MASUMI_SELLER_API_KEY privately in app.env.
# Set BLOCKFROST_PROJECT_ID_PREPROD privately for the payment client.
MASUMI_PAYMENT_SOURCE_TYPE=Web3CardanoV2
