# Use the AWS Elastic IP when a client does not send a TLS server name.
{
	default_sni 13.210.42.0
}

# Amplify serves the frontend. Caddy exposes the two backend UI gates.
# Keep payment and control API ports private.
https://13.210.42.0 {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
			disable_http_challenge
		}
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	handle_path /brand/* {
		root * /srv/tally/brand
		file_server
	}
	# Strip the app prefix before the authenticated app gate receives it.
	handle_path /app-api/* {
		reverse_proxy 127.0.0.1:8798
	}
	handle {
		reverse_proxy 127.0.0.1:8791
	}
}
