[Unit]
Description=Tally operator UI (read-only, proxies GET reads to the control API)
After=tally-services.service
Wants=tally-services.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/tally-app/current
Environment=UI_PORT=8791
Environment=CONTROL_API_URL=http://127.0.0.1:8787
# The web app on Vercel calls the Coworker chat (/coworkers/ask) from the browser. Comma-separated.
Environment=COWORKER_ASK_ORIGINS=https://tally-origins.vercel.app
ExecStart=/home/ubuntu/.bun/bin/bun run ui/server.ts
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
