# Public entry point for Tally. The payment service is NOT exposed here (it listens on 127.0.0.1:3001 only).
13-210-42-0.sslip.io {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	handle_path /brand/* {
		root * /srv/tally/brand
		file_server
	}
	# Read-only evidence API. Its process listens on loopback only.
	@evidenceApi {
		method GET
		path /reliability/evidence/info /reliability/evidence/check
	}
	handle @evidenceApi {
		reverse_proxy 127.0.0.1:8793
	}
	# The checker uses the same React component as the Vercel frontend.
	@evidencePage {
		method GET HEAD
		path /evidence /evidence/
	}
	handle @evidencePage {
		root * /srv/tally/chainlink-evidence/current/web/dist
		rewrite * /evidence-standalone.html
		file_server
	}
	handle /assets/* {
		root * /srv/tally/chainlink-evidence/current/web/dist
		file_server
	}
	# Add the checker link without restarting the existing backend services.
	@evidenceNav {
		method GET HEAD
		path /render.js /styles.css
	}
	handle @evidenceNav {
		root * /srv/tally/chainlink-evidence/current/ui
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8791
	}
}
