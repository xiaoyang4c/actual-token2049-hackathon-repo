# Use the AWS Elastic IP when a client does not send a TLS server name.
{
	default_sni 13.210.42.0
}

# Amplify serves the frontend. Caddy exposes the two backend UI gates.
# Keep payment and control API ports private.
https://13.210.42.0 {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
			disable_http_challenge
		}
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	handle_path /brand/* {
		root * /srv/tally/brand
		file_server
	}
	# Strip the app prefix before the authenticated app gate receives it.
	handle_path /app-api/* {
		reverse_proxy 127.0.0.1:8798
	}
	# Read-only evidence API. Its process listens on loopback only.
	@evidenceApi {
		method GET
		path /reliability/evidence/info /reliability/evidence/check
	}
	handle @evidenceApi {
		reverse_proxy 127.0.0.1:8793
	}
	# The checker uses the same React component as the Vercel frontend.
	@evidencePage {
		method GET HEAD
		path /evidence /evidence/
	}
	handle @evidencePage {
		root * /srv/tally/chainlink-evidence/current/web/dist
		rewrite * /evidence-standalone.html
		file_server
	}
	handle /assets/* {
		root * /srv/tally/chainlink-evidence/current/web/dist
		file_server
	}
	# Add the checker link without restarting the existing backend services.
	@evidenceNav {
		method GET HEAD
		path /render.js /styles.css
	}
	handle @evidenceNav {
		root * /srv/tally/chainlink-evidence/current/ui
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8791
	}
}
