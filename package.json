{
  "name": "prediction-agent-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "services": "bun run services/dev.ts",
    "paper:demo": "bun run services/paper-position-demo.ts",
    "funding:demo": "bun run services/reliability/omnibus-funding-demo.ts",
    "funding:test": "bun test services/reliability/omnibus-funding.test.ts packages/db/test/store.test.ts",
    "payments:demo": "bun run services/cardano-agents-ts/demo.ts",
    "payments:test": "bun test services/cardano-agents-ts services/score-provider.test.ts packages/db",
    "payments:typecheck": "tsc --noEmit -p tsconfig.payments.json",
    "contracts:demo": "bun run services/reliability/contract-demo.ts",
    "contracts:worker": "bun run services/reliability/contract-worker.ts",
    "contracts:smoke": "bun run services/reliability/contract-preprod-smoke.ts",
    "contracts:showcase": "bun run services/reliability/contract-showcase.ts",
    "coworkers:worker": "bun run services/reliability/coworker-worker.ts",
    "anchors:wallet": "bun run services/reliability/anchor-worker.ts wallet",
    "anchors:status": "bun run services/reliability/anchor-worker.ts status",
    "anchors:worker": "bun run services/reliability/anchor-worker.ts worker",
    "evidence:server": "bun run services/reliability/evidence-server.ts",
    "evidence:typecheck": "cd cre/evidence-checker && bun run typecheck",
    "evidence:compile": "cd cre/evidence-checker && bun run compile",
    "test": "bun test packages services ui && cd cre/agent-loop && bun test",
    "typecheck:workflow": "cd cre/agent-loop && bun run typecheck",
    "typecheck:control": "tsc --noEmit -p tsconfig.control.json",
    "simulate": "cd cre && cre workflow simulate agent-loop --target local-settings",
    "simulate:offline": "cd cre && cre workflow simulate agent-loop --target offline-settings",
    "simulate:live": "cd cre && cre workflow simulate agent-loop --target staging-settings",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@blockfrost/blockfrost-js": "6.2.0",
    "@emurgo/cardano-serialization-lib-nodejs": "15.0.3",
    "lz-string": "1.5.0"
  }
}
