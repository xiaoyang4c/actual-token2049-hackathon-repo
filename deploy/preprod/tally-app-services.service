[Unit]
Description=Tally app control API and payment service (Cardano preprod)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/tally-app/current
Environment=CONTROL_API_PORT=8797
Environment=CARDANO_AGENT_PORT=8799
Environment=CONTROL_DB_PATH=/home/ubuntu/tally-app/app-data/agent.sqlite
Environment=CARDANO_RECEIPT_DB=/home/ubuntu/tally-app/app-data/cardano.sqlite
Environment=TALLY_EDITION=app
Environment=MARKETPLACE_REQUIRE_WALLET=on
Environment=CARDANO_MODE=preprod
Environment=CARDANO_ALLOW_NETWORK=true
Environment=CARDANO_NETWORK=cardano-preprod
Environment=TALLY_SECRETS_DIR=/home/ubuntu/tally-app-secrets
# app.env names the app Amplify domain, its preprod pool, and its credentials.
EnvironmentFile=/home/ubuntu/tally-app/app.env
ExecStart=/home/ubuntu/.bun/bin/bun run services
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
