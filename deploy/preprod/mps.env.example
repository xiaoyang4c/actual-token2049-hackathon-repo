# Copy to mps.env (mode 600). Runtime settings only: no wallet seed phrases here.
DATABASE_URL=postgresql://mps:<POSTGRES_PASSWORD>@postgres:5432/masumi_payment?schema=public
# At least 20 characters. Generate: openssl rand -hex 32. Keep a backup: the wallets are encrypted with it.
ENCRYPTION_KEY=<generated key>
PORT=3001
# Free project at https://blockfrost.io, network Cardano preprod. Starts with "preprod".
BLOCKFROST_API_KEY_PREPROD=<blockfrost preprod project id>
AUTO_WITHDRAW_PAYMENTS=true
AUTO_WITHDRAW_REFUNDS=true
